# Copy this file to .env and add your real The One API token.
# Do not commit .env. It is already ignored by .gitignore.
#
# This variable intentionally does not start with VITE_.
# Vite exposes VITE_* variables to browser code, so private tokens should use
# server-only names like this one and be read from vite.config.js instead.

LOTR_API_TOKEN=replace_with_your_the_one_api_token
