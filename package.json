{
  "name": "lotr-char-search",
  "version": "1.0.0",
  "description": "A themed single-page character search app built with JavaScript, Axios, Bootstrap, and The One API.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint:js": "eslint src --ext .js,.jsx",
    "lint:styles": "stylelint \"src/**/*.{scss,css}\"",
    "lint:html": "htmlhint index.html",
    "lint": "npm run lint:js && npm run lint:styles && npm run lint:html",
    "lint:js:fix": "eslint \"src/**/*.{js,jsx}\" --fix",
    "lint:styles:fix": "stylelint \"src/**/*.{scss,css}\" --fix",
    "lint:fix": "npm run lint:js:fix && npm run lint:styles:fix",
    "preview": "vite preview",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ellamkoch/lotr-char-search.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ellamkoch/lotr-char-search/issues"
  },
  "homepage": "https://github.com/ellamkoch/lotr-char-search#readme",
  "dependencies": {
    "axios": "^1.16.0",
    "bootstrap": "~5.3.8",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "eslint": "~9.39.1",
    "htmlhint": "~1.7.1",
    "prettier": "^3.8.3",
    "stylelint": "~16.25.0",
    "stylelint-config-standard": "~39.0.1",
    "vite": "^8.0.10"
  }
}
